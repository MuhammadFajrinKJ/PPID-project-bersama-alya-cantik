---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import InformationService from "../components/InformationService.astro";
import BlockRenderer from "../components/BlockRenderer.astro";
import { pages } from "../data/pages";
import { ArrowRight } from "../components/icons";

const permintaanBlocks = pages["layanan-informasi/prosedur-permintaan-informasi"].blocks;
const keberatanBlocks = pages["layanan-informasi/prosedur-pengajuan-keberatan"].blocks;
const sengketaBlocks = pages["layanan-informasi/prosedur-penyelesaian-sengketa"].blocks;
const standarBlocks = pages["layanan-informasi/standar-pelayanan"].blocks;
---

<MainLayout
  title="Layanan Informasi — PPID BBPPMPV BMTI Kemendikdasmen"
  description="Prosedur Permintaan Informasi, Pengajuan Keberatan, Penyelesaian Sengketa Informasi, Maklumat Pelayanan, Standar Pelayanan, serta Formulir Layanan PPID BBPPMPV BMTI."
>
  <PageHeader
    title="Layanan Informasi Publik"
    eyebrow="Pelayanan Terpusat Satu Pintu"
    description="Panduan prosedur permohonan informasi, pengajuan keberatan, penyelesaian sengketa informasi, standar pelayanan, serta formulir resmi PPID BBPPMPV BMTI."
    breadcrumbs={[{ label: "Layanan Informasi" }]}
    sourceUrl="https://bbppmpvbmti.kemendikdasmen.go.id/Ppid/layanan-ppid-bbppmpv-bmti/"
  />

  <!-- Main Services & Forms Overview -->
  <InformationService />

  <!-- Detailed Procedures Accordion / Sections -->
  <section class="py-16 bg-[#F5F7FA] border-t border-slate-200/80">
    <div class="container-corporate space-y-14">
      <!-- 1. Prosedur Permintaan Informasi -->
      <div id="prosedur-permintaan" class="space-y-4 reveal">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-3">
          <div>
            <span class="section-eyebrow">Prosedur 01</span>
            <h2 class="text-2xl font-extrabold text-[#123B68]">Prosedur Permintaan Informasi</h2>
          </div>
          <a
            href="/layanan-informasi/prosedur-permintaan-informasi"
            class="text-xs font-bold text-[#1769AA] hover:text-[#123B68] inline-flex items-center gap-1"
          >
            <span>Halaman Mandiri</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
        <BlockRenderer blocks={permintaanBlocks} slug="layanan-informasi/prosedur-permintaan-informasi" />
      </div>

      <!-- 2. Prosedur Pengajuan Keberatan -->
      <div id="prosedur-keberatan" class="space-y-4 reveal">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-3">
          <div>
            <span class="section-eyebrow">Prosedur 02</span>
            <h2 class="text-2xl font-extrabold text-[#123B68]">Prosedur Pengajuan Keberatan</h2>
          </div>
          <a
            href="/layanan-informasi/prosedur-pengajuan-keberatan"
            class="text-xs font-bold text-[#1769AA] hover:text-[#123B68] inline-flex items-center gap-1"
          >
            <span>Halaman Mandiri</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
        <BlockRenderer blocks={keberatanBlocks} slug="layanan-informasi/prosedur-pengajuan-keberatan" />
      </div>

      <!-- 3. Prosedur Penyelesaian Sengketa Informasi -->
      <div id="prosedur-sengketa" class="space-y-4 reveal">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-3">
          <div>
            <span class="section-eyebrow">Prosedur 03</span>
            <h2 class="text-2xl font-extrabold text-[#123B68]">
              Prosedur Penyelesaian Sengketa Informasi
            </h2>
          </div>
          <a
            href="/layanan-informasi/prosedur-penyelesaian-sengketa"
            class="text-xs font-bold text-[#1769AA] hover:text-[#123B68] inline-flex items-center gap-1"
          >
            <span>Halaman Mandiri</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
        <BlockRenderer blocks={sengketaBlocks} slug="layanan-informasi/prosedur-penyelesaian-sengketa" />
      </div>

      <!-- 4. Standar Pelayanan -->
      <div id="standar-pelayanan" class="space-y-4 reveal">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-3">
          <div>
            <span class="section-eyebrow">Standar Mutu</span>
            <h2 class="text-2xl font-extrabold text-[#123B68]">Standar Pelayanan BBPPMPV BMTI</h2>
          </div>
          <a
            href="/layanan-informasi/standar-pelayanan"
            class="text-xs font-bold text-[#1769AA] hover:text-[#123B68] inline-flex items-center gap-1"
          >
            <span>Halaman Mandiri</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
        <BlockRenderer blocks={standarBlocks} slug="layanan-informasi/standar-pelayanan" />
      </div>
    </div>
  </section>
</MainLayout>
