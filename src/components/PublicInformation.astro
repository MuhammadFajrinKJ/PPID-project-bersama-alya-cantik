---
import {
  CalendarClock,
  Zap,
  Clock,
  ShieldOff,
  Search,
  ArrowUpRight,
  ArrowRight,
  FileSpreadsheet,
  FolderOpen,
  ExternalLink,
  BarChart3,
} from "./icons";
import { publicInfoCategories } from "../data/site";

const categoryIcons: Record<string, any> = {
  berkala: CalendarClock,
  "setiap-saat": Clock,
  "serta-merta": Zap,
  dikecualikan: ShieldOff,
};
---

<section id="informasi-publik" class="py-20 sm:py-24 bg-[#F5F7FA] relative">
  <div class="container-corporate">
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 reveal">
      <div class="max-w-2xl">
        <span class="section-eyebrow">Keterbukaan Informasi Publik</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#123B68] tracking-tight">
          Klasifikasi Informasi Publik
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          Sesuai Undang-Undang Nomor 14 Tahun 2008 dan Peraturan Komisi Informasi Pusat Nomor 1 Tahun 2021, PPID BBPPMPV BMTI menyediakan empat klasifikasi informasi publik yang dapat diakses masyarakat.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/informasi-publik/daftar-informasi-publik"
          class="btn-primary !py-2.5 !px-4 !text-xs sm:!text-sm"
        >
          <FileSpreadsheet class="w-4 h-4 text-[#E5B84B]" />
          <span>Daftar Informasi Publik (DIP)</span>
        </a>
        <a
          href="/informasi-publik/indeks-kepuasan-masyarakat"
          class="btn-outline-navy !py-2.5 !px-4 !text-xs sm:!text-sm"
        >
          <BarChart3 class="w-4 h-4" />
          <span>Indeks Kepuasan Masyarakat</span>
        </a>
      </div>
    </div>

    <!-- 4 Official Category Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10 reveal reveal-delay-1">
      {
        publicInfoCategories.map((cat) => {
          const Icon = categoryIcons[cat.id] || FolderOpen;
          return (
            <div class="card-corporate p-6 flex flex-col justify-between group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#123B68] via-[#1769AA] to-[#E5B84B]" />
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <div class="w-12 h-12 rounded-xl bg-[#123B68]/8 group-hover:bg-[#123B68] text-[#123B68] group-hover:text-[#E5B84B] flex items-center justify-center transition-colors">
                    <Icon class="w-6 h-6" />
                  </div>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#E5B84B]/20 text-[#123B68]">
                    {cat.badge}
                  </span>
                </div>
                <h3 class="text-lg font-extrabold text-[#123B68] group-hover:text-[#1769AA] transition-colors">
                  {cat.title}
                </h3>
                <p class="text-xs text-slate-600 mt-2 leading-relaxed">{cat.summary}</p>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500">
                  {cat.items.length} Sub-Informasi
                </span>
                <a
                  href={cat.href}
                  class="inline-flex items-center gap-1 text-xs font-bold text-[#1769AA] hover:text-[#123B68]"
                >
                  <span>Buka Kategori</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Interactive Filter Tabs + Search Directory -->
    <div class="card-corporate p-5 sm:p-7 bg-white reveal reveal-delay-2">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <!-- Category Filter Buttons -->
        <div
          class="flex flex-wrap items-center gap-2"
          role="tablist"
          aria-label="Filter Kategori Informasi Publik"
        >
          <button
            type="button"
            data-info-tab="all"
            class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all cursor-pointer bg-[#123B68] text-white shadow-sm"
          >
            Semua Kategori
          </button>
          {
            publicInfoCategories.map((cat) => (
              <button
                type="button"
                data-info-tab={cat.id}
                class="px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-[#F5F7FA] text-slate-700 hover:bg-slate-200/70 hover:text-[#123B68]"
              >
                {cat.title}
                <span class="ml-1.5 px-1.5 py-0.5 text-[10px] rounded-full bg-black/10">
                  {cat.items.length}
                </span>
              </button>
            ))
          }
        </div>

        <!-- Live Search Input inside Public Information -->
        <div class="relative w-full lg:w-80">
          <Search class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            type="search"
            id="public-info-filter-input"
            placeholder="Filter sub-informasi (mis. LHKPN, RKAKL, Renstra)..."
            aria-label="Filter daftar informasi publik"
            class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-[#F5F7FA] border border-slate-200 rounded-lg focus:outline-none focus:border-[#1769AA] focus:bg-white transition-colors"
          />
        </div>
      </div>

      <!-- Filtered Items Grid -->
      <div id="public-info-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-6">
        {
          publicInfoCategories.flatMap((cat) =>
            cat.items.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                data-info-card
                data-category={cat.id}
                data-title={`${item.title} ${item.category} ${cat.title}`.toLowerCase()}
                class="group p-4 rounded-xl border border-slate-200/90 bg-[#F5F7FA]/60 hover:bg-white hover:border-[#1769AA] hover:shadow-md transition-all flex items-start justify-between gap-3"
              >
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[#123B68]/10 text-[#123B68]">
                      {cat.title}
                    </span>
                    <span class="text-[11px] font-medium text-[#1769AA]">{item.category}</span>
                  </div>
                  <h4 class="text-sm font-bold text-slate-800 group-hover:text-[#123B68] leading-snug">
                    {item.title}
                  </h4>
                </div>
                <div class="w-8 h-8 rounded-lg bg-white group-hover:bg-[#123B68] text-slate-500 group-hover:text-[#E5B84B] border border-slate-200/80 flex items-center justify-center shrink-0 transition-colors">
                  {item.external ? (
                    <ExternalLink class="w-4 h-4" />
                  ) : (
                    <ArrowUpRight class="w-4 h-4" />
                  )}
                </div>
              </a>
            ))
          )
        }
      </div>

      <div id="public-info-empty" class="hidden py-10 text-center">
        <p class="text-sm font-bold text-slate-700">
          Tidak ditemukan item informasi publik yang sesuai dengan kata kunci tersebut.
        </p>
        <p class="text-xs text-slate-500 mt-1">
          Silakan reset kata kunci atau pilih tab "Semua Kategori".
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initPublicInfoFilter() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>("[data-info-tab]");
    const cards = document.querySelectorAll<HTMLElement>("[data-info-card]");
    const searchInput = document.getElementById("public-info-filter-input") as HTMLInputElement | null;
    const emptyEl = document.getElementById("public-info-empty");

    let activeCategory = "all";

    const updateGrid = () => {
      const query = (searchInput?.value || "").trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "";
        const text = card.getAttribute("data-title") || "";
        const matchCat = activeCategory === "all" || cat === activeCategory;
        const matchText = !query || text.includes(query);

        if (matchCat && matchText) {
          card.classList.remove("hidden");
          visible++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (emptyEl) {
        emptyEl.classList.toggle("hidden", visible > 0);
      }
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.getAttribute("data-info-tab") || "all";

        tabBtns.forEach((b) => {
          const isCurrent = b === btn;
          b.classList.toggle("bg-[#123B68]", isCurrent);
          b.classList.toggle("text-white", isCurrent);
          b.classList.toggle("shadow-sm", isCurrent);
          b.classList.toggle("bg-[#F5F7FA]", !isCurrent);
          b.classList.toggle("text-slate-700", !isCurrent);
        });

        updateGrid();
      });
    });

    searchInput?.addEventListener("input", updateGrid);
  }

  initPublicInfoFilter();
</script>
