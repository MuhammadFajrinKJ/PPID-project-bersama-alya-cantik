---
import { Image } from "astro:assets";
import {
  ChevronDown,
  ChevronRight,
  Search,
  Menu,
  X,
  ExternalLink,
  FileCheck2,
} from "./icons";
import { navMenu, siteConfig } from "../data/site";
import logoBmti from "../assets/images/brand/logo-bmti.png";
import logoKemendikdasmen from "../assets/images/brand/logo-kemendikdasmen.png";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav
  id="main-navbar"
  aria-label="Navigasi Utama PPID BBPPMPV BMTI"
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300"
>
  <div class="container-corporate">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Brand / Logo Left -->
      <a
        href="/"
        class="flex items-center gap-3 group focus:outline-none shrink-0"
        aria-label="Beranda PPID BBPPMPV BMTI"
      >
        <div class="flex items-center gap-2">
          <Image
            src={logoKemendikdasmen}
            alt="Logo Kementerian Pendidikan Dasar dan Menengah"
            width={42}
            height={42}
            class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <Image
            src={logoBmti}
            alt="Logo BBPPMPV BMTI"
            width={44}
            height={44}
            class="h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        <div class="border-l-2 border-slate-200 pl-3">
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-base sm:text-lg tracking-tight text-[#123B68] leading-none">
              PPID BBPPMPV BMTI
            </span>
            <span class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-[#E5B84B]/20 text-[#123B68] rounded">
              Resmi
            </span>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium mt-0.5 leading-tight max-w-[220px] sm:max-w-none truncate">
            Pejabat Pengelola Informasi & Dokumentasi · Kemendikdasmen
          </p>
        </div>
      </a>

      <!-- Desktop Menu Right -->
      <div class="hidden xl:flex items-center gap-1">
        <ul class="flex items-center gap-0.5">
          {
            navMenu.map((item, idx) => {
              const active = isActive(item.href);
              const hasChildren = item.children && item.children.length > 0;
              const isMega = item.label === "Informasi Publik" || item.label === "Layanan Informasi";
              const alignRight = idx >= 4;

              return (
                <li class="relative group/nav">
                  <a
                    href={item.href}
                    class:list={[
                      "relative flex items-center gap-1 px-2.5 2xl:px-3 py-2 text-xs 2xl:text-[13px] font-semibold rounded-lg transition-colors duration-200 whitespace-nowrap",
                      active
                        ? "text-[#123B68] bg-slate-100/80"
                        : "text-slate-700 hover:text-[#123B68] hover:bg-slate-50",
                    ]}
                  >
                    <span>{item.label}</span>
                    {hasChildren && (
                      <ChevronDown class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-hover/nav:rotate-180 group-hover/nav:text-[#1769AA]" />
                    )}
                    <span
                      class:list={[
                        "absolute bottom-0.5 left-2.5 right-2.5 h-[3px] rounded-full transition-all duration-300",
                        active
                          ? "bg-[#E5B84B] opacity-100 scale-x-100"
                          : "bg-[#1769AA] opacity-0 scale-x-0 group-hover/nav:opacity-100 group-hover/nav:scale-x-100",
                      ]}
                    />
                  </a>

                  {hasChildren && !isMega && (
                    <div
                      class:list={[
                        "invisible opacity-0 translate-y-2 group-hover/nav:visible group-hover/nav:opacity-100 group-hover/nav:translate-y-0 focus-within:visible focus-within:opacity-100 focus-within:translate-y-0 transition-all duration-200 ease-out absolute top-full pt-2 w-72 z-50",
                        alignRight ? "right-0" : "left-0",
                      ]}
                    >
                      <div class="bg-white rounded-xl shadow-xl border border-slate-200/90 p-2 overflow-hidden">
                        <div class="h-1 w-full bg-gradient-to-r from-[#123B68] via-[#1769AA] to-[#E5B84B] rounded-t-lg -mt-2 mb-2" />
                        {item.children!.map((sub) => (
                          <div class="relative group/sub">
                            <a
                              href={sub.href}
                              target={sub.external ? "_blank" : undefined}
                              rel={sub.external ? "noopener noreferrer" : undefined}
                              class="flex items-start justify-between gap-2 px-3 py-2 rounded-lg hover:bg-[#F5F7FA] transition-colors"
                            >
                              <div>
                                <div class="text-xs font-semibold text-slate-800 group-hover/sub:text-[#123B68] flex items-center gap-1.5">
                                  <span>{sub.label}</span>
                                  {sub.external && <ExternalLink class="w-3 h-3 text-slate-400" />}
                                </div>
                                {sub.description && (
                                  <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1">
                                    {sub.description}
                                  </p>
                                )}
                              </div>
                            </a>
                            {sub.children && sub.children.length > 0 && (
                              <div class="pl-4 pr-2 pb-1.5 space-y-1 border-l-2 border-slate-100 ml-3 mb-1">
                                {sub.children.map((leaf) => (
                                  <a
                                    href={leaf.href}
                                    target={leaf.external ? "_blank" : undefined}
                                    rel={leaf.external ? "noopener noreferrer" : undefined}
                                    class="flex items-center justify-between gap-1.5 px-2.5 py-1 text-[11px] font-medium text-slate-600 hover:text-[#123B68] hover:bg-slate-50 rounded-md transition-colors"
                                  >
                                    <span class="truncate">{leaf.label}</span>
                                    {leaf.external && <ExternalLink class="w-3 h-3 text-slate-400 shrink-0" />}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {hasChildren && isMega && (
                    <div class="invisible opacity-0 translate-y-2 group-hover/nav:visible group-hover/nav:opacity-100 group-hover/nav:translate-y-0 focus-within:visible focus-within:opacity-100 focus-within:translate-y-0 transition-all duration-200 ease-out absolute right-0 top-full pt-2 w-[760px] z-50">
                      <div class="bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden">
                        <div class="h-1.5 w-full bg-gradient-to-r from-[#123B68] via-[#1769AA] to-[#E5B84B]" />
                        <div class="p-5 grid grid-cols-12 gap-5">
                          <div class="col-span-5 space-y-1.5 border-r border-slate-100 pr-4">
                            <div class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-[#1769AA]">
                              Menu {item.label}
                            </div>
                            {item.children!.map((sub) => (
                              <a
                                href={sub.href}
                                target={sub.external ? "_blank" : undefined}
                                rel={sub.external ? "noopener noreferrer" : undefined}
                                class="block px-3 py-2 rounded-lg hover:bg-[#F5F7FA] transition-colors group/mitem"
                              >
                                <div class="text-sm font-semibold text-slate-800 group-hover/mitem:text-[#123B68] flex items-center justify-between">
                                  <span>{sub.label}</span>
                                  <ChevronRight class="w-3.5 h-3.5 text-slate-400 group-hover/mitem:text-[#1769AA] group-hover/mitem:translate-x-0.5 transition-all" />
                                </div>
                                {sub.description && (
                                  <p class="text-xs text-slate-500 mt-0.5 leading-snug">
                                    {sub.description}
                                  </p>
                                )}
                              </a>
                            ))}
                          </div>
                          <div class="col-span-7 flex flex-col justify-between">
                            <div>
                              <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-[#123B68]">
                                Akses Cepat Sub-Halaman Resmi
                              </div>
                              <div class="grid grid-cols-2 gap-x-3 gap-y-1 mt-1 max-h-72 overflow-y-auto pr-1">
                                {item.children!
                                  .flatMap((s) => s.children || [])
                                  .map((leaf) => (
                                    <a
                                      href={leaf.href}
                                      target={leaf.external ? "_blank" : undefined}
                                      rel={leaf.external ? "noopener noreferrer" : undefined}
                                      class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-[#123B68] hover:bg-slate-50 rounded-md transition-colors"
                                    >
                                      <span class="w-1.5 h-1.5 rounded-full bg-[#E5B84B] shrink-0" />
                                      <span class="truncate">{leaf.label}</span>
                                      {leaf.external && <ExternalLink class="w-3 h-3 text-slate-400 shrink-0" />}
                                    </a>
                                  ))}
                              </div>
                            </div>
                            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between bg-[#F5F7FA] px-3.5 py-2.5 rounded-xl">
                              <div>
                                <p class="text-xs font-bold text-[#123B68]">
                                  Lihat Seluruh {item.label}
                                </p>
                                <p class="text-[11px] text-slate-500">
                                  Akses direktori lengkap sesuai portal PPID BBPPMPV BMTI
                                </p>
                              </div>
                              <a
                                href={item.href}
                                class="text-xs font-bold text-[#1769AA] hover:text-[#123B68] flex items-center gap-1 shrink-0"
                              >
                                Buka Halaman
                                <ChevronRight class="w-3.5 h-3.5" />
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>

        <!-- Action Buttons: Search + CTA -->
        <div class="flex items-center gap-2.5 ml-3 pl-3 border-l border-slate-200">
          <button
            type="button"
            data-open-search
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200/80 hover:text-[#123B68] rounded-lg transition-colors cursor-pointer"
            aria-label="Cari Informasi Publik (Ctrl+K)"
          >
            <Search class="w-4 h-4 text-[#1769AA]" />
            <span>Cari</span>
            <kbd class="hidden 2xl:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white text-slate-500 rounded border border-slate-200">
              Ctrl K
            </kbd>
          </button>

          <a
            href="/layanan-informasi/formulir-permintaan-informasi"
            class="btn-primary !py-2 !px-4 !text-xs whitespace-nowrap"
          >
            <FileCheck2 class="w-4 h-4 text-[#E5B84B]" />
            <span>Permohonan Informasi</span>
          </a>
        </div>
      </div>

      <!-- Mobile Search & Hamburger Buttons -->
      <div class="flex xl:hidden items-center gap-2">
        <button
          type="button"
          data-open-search
          class="p-2.5 rounded-lg text-slate-700 hover:text-[#123B68] hover:bg-slate-100 transition-colors cursor-pointer"
          aria-label="Cari Informasi Publik"
        >
          <Search class="w-5 h-5" />
        </button>

        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          aria-label="Buka Menu Navigasi"
          class="p-2.5 rounded-lg text-[#123B68] bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
        >
          <Menu id="icon-menu-open" class="w-6 h-6" />
          <X id="icon-menu-close" class="w-6 h-6 hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Responsive Navigation Drawer -->
  <div
    id="mobile-menu-drawer"
    class="hidden xl:hidden border-t border-slate-200 bg-white max-h-[calc(100vh-5rem)] overflow-y-auto shadow-2xl"
  >
    <div class="container-corporate py-4 space-y-2">
      {
        navMenu.map((item, idx) => {
          const active = isActive(item.href);
          const hasChildren = item.children && item.children.length > 0;

          return (
            <div class="border-b border-slate-100 last:border-b-0 pb-2">
              <div class="flex items-center justify-between">
                <a
                  href={item.href}
                  class:list={[
                    "flex-1 py-2.5 px-3 rounded-lg text-sm font-bold transition-colors",
                    active
                      ? "text-[#123B68] bg-[#F5F7FA] border-l-4 border-[#E5B84B]"
                      : "text-slate-800 hover:bg-slate-50",
                  ]}
                >
                  {item.label}
                </a>
                {hasChildren && (
                  <button
                    type="button"
                    data-mobile-sub-toggle={`mobile-sub-${idx}`}
                    aria-expanded="false"
                    aria-label={`Submenu ${item.label}`}
                    class="p-2.5 text-slate-500 hover:text-[#123B68] rounded-lg hover:bg-slate-100 cursor-pointer"
                  >
                    <ChevronDown class="w-4 h-4 transition-transform duration-200" />
                  </button>
                )}
              </div>

              {hasChildren && (
                <div id={`mobile-sub-${idx}`} class="hidden pl-4 pr-2 pt-1 pb-2 space-y-1.5">
                  {item.children!.map((sub) => (
                    <div>
                      <a
                        href={sub.href}
                        target={sub.external ? "_blank" : undefined}
                        rel={sub.external ? "noopener noreferrer" : undefined}
                        class="flex items-center justify-between py-1.5 px-3 text-xs font-semibold text-slate-700 hover:text-[#123B68] hover:bg-slate-50 rounded-md"
                      >
                        <span>{sub.label}</span>
                        {sub.external && <ExternalLink class="w-3.5 h-3.5 text-slate-400" />}
                      </a>
                      {sub.children && sub.children.length > 0 && (
                        <div class="pl-3 mt-1 border-l-2 border-slate-200 space-y-1">
                          {sub.children.map((leaf) => (
                            <a
                              href={leaf.href}
                              target={leaf.external ? "_blank" : undefined}
                              rel={leaf.external ? "noopener noreferrer" : undefined}
                              class="flex items-center gap-1.5 py-1 px-2 text-xs text-slate-600 hover:text-[#123B68]"
                            >
                              <span class="w-1 h-1 rounded-full bg-[#E5B84B]" />
                              <span>{leaf.label}</span>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }

      <div class="pt-3 flex flex-col sm:flex-row gap-2.5">
        <a
          href="/layanan-informasi/formulir-permintaan-informasi"
          class="btn-primary w-full justify-center !py-2.5"
        >
          <FileCheck2 class="w-4 h-4 text-[#E5B84B]" />
          <span>Formulir Permohonan Informasi</span>
        </a>
        <a
          href="/layanan-informasi/formulir-keberatan-informasi"
          class="btn-outline-navy w-full justify-center !py-2.5"
        >
          <span>Formulir Keberatan Informasi</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNavbar() {
    const navbar = document.getElementById("main-navbar");
    const mobileToggle = document.getElementById("mobile-menu-toggle");
    const mobileDrawer = document.getElementById("mobile-menu-drawer");
    const iconOpen = document.getElementById("icon-menu-open");
    const iconClose = document.getElementById("icon-menu-close");

    // Sticky scroll effect
    const handleScroll = () => {
      if (!navbar) return;
      if (window.scrollY > 24) {
        navbar.classList.add("shadow-lg", "bg-white");
        navbar.classList.remove("bg-white/95");
      } else {
        navbar.classList.remove("shadow-lg", "bg-white");
        navbar.classList.add("bg-white/95");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // Mobile drawer toggle
    if (mobileToggle && mobileDrawer && iconOpen && iconClose) {
      mobileToggle.addEventListener("click", () => {
        const isHidden = mobileDrawer.classList.contains("hidden");
        if (isHidden) {
          mobileDrawer.classList.remove("hidden");
          iconOpen.classList.add("hidden");
          iconClose.classList.remove("hidden");
          mobileToggle.setAttribute("aria-expanded", "true");
        } else {
          mobileDrawer.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          iconClose.classList.add("hidden");
          mobileToggle.setAttribute("aria-expanded", "false");
        }
      });
    }

    // Mobile accordion submenus
    const subToggles = document.querySelectorAll("[data-mobile-sub-toggle]");
    subToggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-mobile-sub-toggle");
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        const icon = btn.querySelector("svg");
        if (!targetEl) return;

        const isHidden = targetEl.classList.contains("hidden");
        if (isHidden) {
          targetEl.classList.remove("hidden");
          btn.setAttribute("aria-expanded", "true");
          icon?.classList.add("rotate-180");
        } else {
          targetEl.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
          icon?.classList.remove("rotate-180");
        }
      });
    });
  }

  initNavbar();
</script>
