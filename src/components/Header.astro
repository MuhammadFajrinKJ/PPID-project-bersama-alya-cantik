---
import {
  Phone,
  Mail,
  Clock,
  ExternalLink,
  Search,
  X,
  FileText,
  FolderOpen,
  Globe,
  ArrowUpRight,
} from "./icons";
import Navbar from "./Navbar.astro";
import { siteConfig, getSearchIndex } from "../data/site";

const searchIndex = getSearchIndex();
---

<!-- Top Corporate Utility Bar (Inspired by Pertamina Header Utility Strip) -->
<div class="bg-[#0A2544] text-slate-200 text-xs border-b border-white/10">
  <div class="container-corporate">
    <div class="flex flex-wrap items-center justify-between py-2 gap-3">
      <!-- Left: Official Identity & Service Hours -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <span class="inline-flex items-center gap-1.5 font-semibold text-white">
          <span class="w-2 h-2 rounded-full bg-[#E5B84B] animate-pulse"></span>
          <span>Kemendikdasmen RI · BBPPMPV BMTI</span>
        </span>
        <span class="hidden md:inline-flex items-center gap-1.5 text-slate-300">
          <Clock class="w-3.5 h-3.5 text-[#E5B84B]" />
          <span>ULP: Senin–Jumat 08.00–15.30 WIB</span>
        </span>
        <a
          href={siteConfig.contact.phoneHref}
          class="hidden sm:inline-flex items-center gap-1.5 text-slate-300 hover:text-[#E5B84B] transition-colors"
        >
          <Phone class="w-3.5 h-3.5 text-[#E5B84B]" />
          <span>{siteConfig.contact.phone}</span>
        </a>
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="hidden lg:inline-flex items-center gap-1.5 text-slate-300 hover:text-[#E5B84B] transition-colors"
        >
          <Mail class="w-3.5 h-3.5 text-[#E5B84B]" />
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>

      <!-- Right: Quick Portal Links -->
      <div class="flex items-center gap-3 sm:gap-4 ml-auto">
        <a
          href="https://bbppmpvbmti.kemendikdasmen.go.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-slate-300 hover:text-[#E5B84B] transition-colors font-medium"
        >
          <span>Web Utama BMTI</span>
          <ExternalLink class="w-3 h-3" />
        </a>
        <span class="text-white/20">|</span>
        <a
          href="https://wbs.kemendikdasmen.go.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-slate-300 hover:text-[#E5B84B] transition-colors font-medium"
        >
          <span>WBS</span>
          <ExternalLink class="w-3 h-3" />
        </a>
        <span class="text-white/20">|</span>
        <a
          href="https://www.lapor.go.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-slate-300 hover:text-[#E5B84B] transition-colors font-medium"
        >
          <span>SP4N-LAPOR!</span>
          <ExternalLink class="w-3 h-3" />
        </a>
        <span class="hidden sm:inline text-white/20">|</span>
        <a
          href="https://ult.kemendikdasmen.go.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-slate-300 hover:text-[#E5B84B] transition-colors font-medium"
        >
          <span>ULT Kemendikdasmen</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Sticky Main Navigation Bar -->
<Navbar />

<!-- Interactive Global Search Modal -->
<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-title"
  class="fixed inset-0 z-[100] hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-[#0A2544]/70 backdrop-blur-sm transition-opacity"
>
  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
    <div class="p-4 border-b border-slate-200 flex items-center gap-3 bg-[#F5F7FA]">
      <Search class="w-5 h-5 text-[#1769AA] shrink-0" />
      <input
        id="global-search-input"
        type="search"
        placeholder="Cari informasi publik, regulasi, formulir, laporan, atau dokumen PBJ..."
        class="w-full bg-transparent text-slate-800 placeholder-slate-400 text-sm sm:text-base font-medium focus:outline-none"
        autocomplete="off"
      />
      <button
        type="button"
        id="close-search-modal"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-200/70 transition-colors cursor-pointer"
        aria-label="Tutup Pencarian"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <div class="px-4 py-2 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
      <span id="search-modal-title" class="font-semibold text-[#123B68]">
        Direktori Pencarian Informasi Publik & Dokumen PPID BBPPMPV BMTI
      </span>
      <span>Tekan <kbd class="px-1.5 py-0.5 bg-white border rounded text-[10px]">ESC</kbd> untuk menutup</span>
    </div>

    <div id="global-search-results" class="max-h-[60vh] overflow-y-auto divide-y divide-slate-100 p-2">
      {
        searchIndex.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            data-search-entry
            data-search-text={`${item.title} ${item.category} ${item.description}`.toLowerCase()}
            class="flex items-start justify-between gap-3 p-3 rounded-xl hover:bg-[#F5F7FA] transition-colors group"
          >
            <div class="flex items-start gap-3 min-w-0">
              <div class="w-9 h-9 rounded-lg bg-[#123B68]/8 text-[#123B68] flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-[#123B68] group-hover:text-white transition-colors">
                {item.kind === "folder" ? (
                  <FolderOpen class="w-4 h-4" />
                ) : item.external ? (
                  <Globe class="w-4 h-4" />
                ) : (
                  <FileText class="w-4 h-4" />
                )}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#1769AA]/10 text-[#1769AA]">
                    {item.category}
                  </span>
                  {item.external && (
                    <span class="text-[10px] font-medium text-slate-400">Tautan Eksternal</span>
                  )}
                </div>
                <h4 class="text-sm font-bold text-slate-800 group-hover:text-[#123B68] mt-1 truncate">
                  {item.title}
                </h4>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">{item.description}</p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-slate-400 group-hover:text-[#1769AA] shrink-0 mt-1" />
          </a>
        ))
      }
      <div id="global-search-empty" class="hidden py-10 text-center">
        <p class="text-sm font-semibold text-slate-700">Tidak ditemukan dokumen atau halaman yang cocok.</p>
        <p class="text-xs text-slate-500 mt-1">
          Silakan gunakan kata kunci lain seperti "DIP", "LHKPN", "RKAKL", "Renstra", "Maklumat", atau "Formulir".
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initSearchModal() {
    const modal = document.getElementById("search-modal");
    const input = document.getElementById("global-search-input") as HTMLInputElement | null;
    const closeBtn = document.getElementById("close-search-modal");
    const openBtns = document.querySelectorAll("[data-open-search]");
    const entries = document.querySelectorAll<HTMLElement>("[data-search-entry]");
    const emptyState = document.getElementById("global-search-empty");

    const openModal = (initialQuery = "") => {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      if (input) {
        if (initialQuery) {
          input.value = initialQuery;
          filterEntries(initialQuery);
        }
        setTimeout(() => input.focus(), 50);
      }
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    };

    const filterEntries = (query: string) => {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;

      entries.forEach((el) => {
        const text = el.getAttribute("data-search-text") || "";
        if (!q || text.includes(q)) {
          el.classList.remove("hidden");
          visibleCount++;
        } else {
          el.classList.add("hidden");
        }
      });

      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
      }
    };

    openBtns.forEach((btn) => {
      btn.addEventListener("click", () => openModal());
    });

    closeBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    input?.addEventListener("input", () => {
      filterEntries(input.value);
    });

    window.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        openModal();
      } else if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  initSearchModal();
</script>
