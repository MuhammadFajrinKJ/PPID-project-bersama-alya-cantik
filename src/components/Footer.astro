---
import { Image } from "astro:assets";
import {
  MapPin,
  Phone,
  Mail,
  Clock,
  ExternalLink,
  ArrowUp,
  ChevronRight,
  MessageCircle,
} from "./icons";
import { siteConfig } from "../data/site";
import logoBmti from "../assets/images/brand/logo-bmti.png";
import logoKemendikdasmen from "../assets/images/brand/logo-kemendikdasmen.png";

const quickNavProfil = [
  { label: "Profil PPID BBPPMPV BMTI", href: "/profil" },
  { label: "Struktur Organisasi PPID", href: "/profil/struktur-organisasi" },
  { label: "Tugas dan Fungsi PPID", href: "/profil/tugas-dan-fungsi" },
  { label: "Visi dan Misi PPID", href: "/profil/visi-dan-misi" },
  { label: "Daftar Pejabat Struktural", href: "/informasi-publik/daftar-pejabat-struktural" },
  { label: "Daftar Kepala BBPPMPV BMTI", href: "/informasi-publik/daftar-kepala" },
];

const quickNavInfo = [
  { label: "Regulasi & POS Layanan", href: "/informasi-publik/regulasi" },
  { label: "Daftar Informasi Publik (DIP)", href: "/informasi-publik/daftar-informasi-publik" },
  { label: "Informasi Berkala", href: "/informasi-publik/informasi-berkala" },
  { label: "Informasi Setiap Saat", href: "/informasi-publik/informasi-setiap-saat" },
  { label: "Informasi Serta Merta", href: "/informasi-publik/informasi-serta-merta" },
  { label: "Informasi Dikecualikan", href: "/informasi-publik/informasi-dikecualikan" },
  { label: "Indeks Kepuasan Masyarakat", href: "/informasi-publik/indeks-kepuasan-masyarakat" },
];

const quickNavLayanan = [
  { label: "Maklumat Pelayanan", href: "/layanan-informasi/maklumat" },
  { label: "Standar Pelayanan", href: "/layanan-informasi/standar-pelayanan" },
  { label: "Prosedur Permintaan Informasi", href: "/layanan-informasi/prosedur-permintaan-informasi" },
  { label: "Prosedur Pengajuan Keberatan", href: "/layanan-informasi/prosedur-pengajuan-keberatan" },
  { label: "Prosedur Penyelesaian Sengketa", href: "/layanan-informasi/prosedur-penyelesaian-sengketa" },
  { label: "Formulir Permintaan Informasi", href: "/layanan-informasi/formulir-permintaan-informasi" },
  { label: "Formulir Keberatan Informasi", href: "/layanan-informasi/formulir-keberatan-informasi" },
];
---

<footer class="bg-[#07192F] text-slate-300 border-t-4 border-[#E5B84B] mt-auto">
  <!-- Main Footer Content -->
  <div class="container-corporate pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      <!-- Column 1: Brand, Address, Official Contact (4 cols) -->
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="flex items-center gap-3 group">
          <div class="flex items-center gap-2 bg-white/10 p-2 rounded-xl border border-white/15">
            <Image
              src={logoKemendikdasmen}
              alt="Logo Kementerian Pendidikan Dasar dan Menengah"
              width={40}
              height={40}
              class="h-9 w-auto object-contain"
            />
            <Image
              src={logoBmti}
              alt="Logo BBPPMPV BMTI"
              width={42}
              height={42}
              class="h-10 w-auto object-contain"
            />
          </div>
          <div>
            <h2 class="text-base font-extrabold text-white tracking-tight">
              PPID BBPPMPV BMTI
            </h2>
            <p class="text-xs text-[#E5B84B] font-semibold">
              Kementerian Pendidikan Dasar dan Menengah
            </p>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Pejabat Pengelola Informasi dan Dokumentasi (PPID) Balai Besar Pengembangan Penjaminan Mutu Pendidikan Vokasi Bidang Mesin dan Teknik Industri.
        </p>

        <div class="space-y-2.5 text-xs sm:text-sm">
          <div class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-[#E5B84B] shrink-0 mt-1" />
            <span>{siteConfig.contact.address}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-[#E5B84B] shrink-0" />
            <span>
              Telp:{" "}
              <a href={siteConfig.contact.phoneHref} class="text-white hover:text-[#E5B84B] font-medium">
                {siteConfig.contact.phone}
              </a>{" "}
              · Faks: {siteConfig.contact.fax}
            </span>
          </div>
          <div class="flex items-center gap-2.5">
            <MessageCircle class="w-4 h-4 text-[#E5B84B] shrink-0" />
            <span>
              WhatsApp ULP:{" "}
              <a
                href={siteConfig.contact.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white hover:text-[#E5B84B] font-medium"
              >
                {siteConfig.contact.whatsapp}
              </a>
            </span>
          </div>
          <div class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-[#E5B84B] shrink-0" />
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="text-white hover:text-[#E5B84B] font-medium break-all"
            >
              {siteConfig.contact.email}
            </a>
          </div>
          <div class="flex items-start gap-2.5">
            <Clock class="w-4 h-4 text-[#E5B84B] shrink-0 mt-0.5" />
            <span>
              Senin–Kamis 09.00–15.00 WIB · Jumat 09.00–15.30 WIB (Pendaftaran 08.00–11.00 WIB)
            </span>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Navigation - Profil & Publikasi (2.5 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#E5B84B]">
          Profil & Publikasi
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          {
            quickNavProfil.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
                >
                  <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/publikasi/majalah-swara"
              class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
            >
              <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
              <span>Majalah Swara</span>
            </a>
          </li>
          <li>
            <a
              href="/publikasi/galeri-dokumentasi"
              class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
            >
              <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
              <span>Galeri Dokumentasi</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Quick Navigation - Informasi Publik (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#E5B84B]">
          Informasi Publik & PBJ
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          {
            quickNavInfo.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
                >
                  <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/pbj/dokumen-pengadaan-barang-jasa"
              class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
            >
              <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
              <span>Dokumen Pengadaan (PBJ)</span>
            </a>
          </li>
          <li>
            <a
              href="/monev-kip"
              class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
            >
              <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
              <span>Bukti Dukung Monev KIP</span>
            </a>
          </li>
          <li>
            <a
              href="/tautan"
              class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
            >
              <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
              <span>Tautan Eksternal Resmi</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Quick Navigation - Layanan & Media Sosial (3 cols) -->
      <div class="lg:col-span-3 space-y-5">
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#E5B84B] mb-4">
            Layanan Informasi
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm">
            {
              quickNavLayanan.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white hover:translate-x-0.5 transition-all"
                  >
                    <ChevronRight class="w-3.5 h-3.5 text-[#1769AA]" />
                    <span>{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="pt-3 border-t border-white/10">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2.5">
            Kanal Resmi & Media Sosial
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              siteConfig.socials.map((soc) => (
                <a
                  href={soc.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg bg-white/8 hover:bg-[#1769AA] text-xs font-semibold text-white inline-flex items-center gap-1.5 border border-white/10 transition-colors"
                >
                  <span>{soc.name}</span>
                  <ExternalLink class="w-3 h-3 text-[#E5B84B]" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright & Back to Top Bar -->
  <div class="border-t border-white/10 bg-[#051224]">
    <div class="container-corporate py-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="text-center sm:text-left">
        <p>
          &copy; {new Date().getFullYear()}{" "}
          <strong class="text-white">PPID BBPPMPV BMTI</strong> — Kementerian Pendidikan Dasar dan Menengah Republik Indonesia. Hak Cipta Dilindungi.
        </p>
        <p class="text-[11px] text-slate-500 mt-0.5">
          Sumber Resmi:{" "}
          <a
            href={siteConfig.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-[#E5B84B] underline"
          >
            bbppmpvbmti.kemendikdasmen.go.id/Ppid
          </a>
        </p>
      </div>

      <button
        type="button"
        id="scroll-to-top-btn"
        aria-label="Kembali ke atas halaman"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white/10 hover:bg-[#E5B84B] text-white hover:text-[#07192F] font-bold text-xs transition-colors cursor-pointer"
      >
        <span>Kembali ke Atas</span>
        <ArrowUp class="w-4 h-4" />
      </button>
    </div>
  </div>
</footer>

<script>
  document.getElementById("scroll-to-top-btn")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
