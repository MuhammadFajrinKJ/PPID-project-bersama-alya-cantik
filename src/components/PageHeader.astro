---
import { Image } from "astro:assets";
import { Home, ChevronRight, ExternalLink } from "./icons";
import gedungBmti from "../assets/images/hero/gedung-bmti.jpg";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  sourceUrl?: string;
}

const {
  title,
  eyebrow = "PPID BBPPMPV BMTI",
  description,
  breadcrumbs = [],
  sourceUrl,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#07192F] text-white py-14 sm:py-18 border-b border-white/10">
  <div class="absolute inset-0 z-0">
    <Image
      src={gedungBmti}
      alt="Gedung Utama BBPPMPV BMTI"
      widths={[640, 1280]}
      sizes="100vw"
      class="w-full h-full object-cover object-center opacity-25"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#07192F] via-[#123B68]/95 to-[#123B68]/80" />
  </div>

  <div class="container-corporate relative z-10">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-300">
        <li>
          <a href="/" class="inline-flex items-center gap-1 hover:text-[#E5B84B] transition-colors">
            <Home class="w-3.5 h-3.5 text-[#E5B84B]" />
            <span>Beranda</span>
          </a>
        </li>
        {
          breadcrumbs.map((crumb) => (
            <li class="inline-flex items-center gap-1.5">
              <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-[#E5B84B] transition-colors">
                  {crumb.label}
                </a>
              ) : (
                <span class="text-[#E5B84B] font-semibold">{crumb.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="max-w-3xl">
        <span class="section-eyebrow section-eyebrow-light !mb-2">{eyebrow}</span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {title}
        </h1>
        {
          description && (
            <p class="mt-3 text-sm sm:text-base text-slate-200 leading-relaxed">
              {description}
            </p>
          )
        }
      </div>

      {
        sourceUrl && (
          <a
            href={sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="self-start lg:self-end inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold text-slate-200 border border-white/20 transition-colors shrink-0"
          >
            <span>Halaman Sumber Asli</span>
            <ExternalLink class="w-3.5 h-3.5 text-[#E5B84B]" />
          </a>
        )
      }
    </div>
  </div>
</section>
